{
  "name": "coral",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A Markdown knowledge base, Obsidian Vault browser and read-write MCP server",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && tsx watch src/server.ts",
    "build": "tsc && esbuild src/client.ts src/mermaid-frame.ts src/html-frame.ts src/html-runtime.ts --bundle --minify --outdir=dist/public",
    "start": "node dist/server.js",
    "mcp": "tsx src/stdio.ts",
    "mcp:prod": "node dist/stdio.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "lucide": "^0.468.0",
    "markdown-it": "^14.3.3",
    "mermaid": "^12.2.0",
    "multer": "^2.0.2",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
